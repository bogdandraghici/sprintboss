# Copy to .env and fill in. Or skip all of this and run `npm run mock`.
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@your-org.com
JIRA_API_TOKEN=your-api-token
JIRA_BOARD_ID=123

# Optional
# API_PORT=4000
# MOCK=1                # serve generated sprint data, no credentials needed
# MOCK_SCENARIO=doomed  # doomed (enraged forecast, default) | healthy (on track)
# MOCK_EVOLVE=1         # mock sprint mutates a little on each poll (default on)
